<%
  |
    String                   $device_name,
    String                   $media_type,
    String                   $device,
    Bacula::Yesno            $label_media,
    Bacula::Yesno            $random_access,
    Bacula::Yesno            $automatic_mount,
    Bacula::Yesno            $removable_media,
    Bacula::Yesno            $always_open,
    Integer                  $maxconcurjobs,
    Optional[Integer]        $drive_index,
    Optional[Integer]        $volume_poll_interval,
    Optional[Bacula::Yesno]  $autochanger,
    Optional[String]         $maximum_spool_size,
    Optional[String]         $maximum_file_size,
    Optional[String]         $spool_directory,
    Optional[String]         $alert_command,
  |
-%>
Device {
    Name                 = <%= $device_name %>
    Media Type           = <%= $media_type %>
    Archive Device       = <%= $device %>
    LabelMedia           = <%= bacula::yesno2str($label_media) %>; # lets Bacula label unlabeled media
    Random Access        = <%= bacula::yesno2str($random_access) %>;
    AutomaticMount       = <%= bacula::yesno2str($automatic_mount) %>;
    RemovableMedia       = <%= bacula::yesno2str($removable_media) %>;
    AlwaysOpen           = <%= bacula::yesno2str($always_open) %>;
    Maximum Concurrent Jobs = <%= $maxconcurjobs %>
<% if $drive_index { -%>
    Drive Index          = <%= $drive_index %>
<% } -%>
<% if $volume_poll_interval { -%>
    Volume Poll Interval = <%= $volume_poll_interval %>;
<% } -%>
<% if $autochanger { -%>
    Autochanger          = <%= $autochanger %>;
<% } -%>
<% if $maximum_spool_size { -%>
    Maximum Spool Size   = <%= $maximum_spool_size %>
<% } -%>
<% if $maximum_file_size { -%>
    Maximum File Size    = <%= $maximum_file_size %>
<% } -%>
<% if $spool_directory { -%>
    Spool Directory      = <%= $spool_directory %>
<% } -%>
<% if $alert_command { -%>
    Alert Command        = "<%= $alert_command %>"
<% } -%>
}
